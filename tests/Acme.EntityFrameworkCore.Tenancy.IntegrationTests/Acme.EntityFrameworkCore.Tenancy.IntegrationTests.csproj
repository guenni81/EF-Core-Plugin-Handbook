<Project Sdk="Microsoft.NET.Sdk">
  <!-- Integration tests against a real PostgreSQL via Testcontainers (requires Docker) -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <!-- Scaffolding roundtrip: reverse engineering and compiling the generated code (Roslyn) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" />
    <!-- Tooling security fix, see Directory.Packages.props -->
    <PackageReference Include="System.Security.Cryptography.Xml" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Acme.EntityFrameworkCore.Tenancy.PostgreSQL\Acme.EntityFrameworkCore.Tenancy.PostgreSQL.csproj" />
    <ProjectReference Include="..\..\src\Acme.EntityFrameworkCore.Functions.PostgreSQL\Acme.EntityFrameworkCore.Functions.PostgreSQL.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
