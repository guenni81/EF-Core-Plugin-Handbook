<Project Sdk="Microsoft.NET.Sdk">

  <!-- Minimal NativeAOT application with precompiled queries. PublishAot is passed only to
       "dotnet publish": with it in the project, EF refuses to build the model at design time. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Microsoft.EntityFrameworkCore.GeneratedInterceptors</InterceptorsNamespaces>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Acme.EntityFrameworkCore.Tenancy.PostgreSQL" Version="$(AcmeVersion)" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="$(EFCoreVersion)">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Generates compiled model and precompiled queries during publish -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tasks" Version="$(EFCoreVersion)">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
