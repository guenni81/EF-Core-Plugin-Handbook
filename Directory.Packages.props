<Project>
  <!-- Pinned to one major version (internal APIs change between majors). NuGet resolves a
       range to its lowest version, so the regular build runs against 10.0.0. The compatibility
       workflow sets EFCoreVersion=10.0.* to test the newest stable patches of the range
       (chapter "Versioning and compatibility"). -->
  <PropertyGroup>
    <EFCoreVersion Condition="'$(EFCoreVersion)' == ''">[10.0.0,11.0.0)</EFCoreVersion>
    <CentralPackageFloatingVersionsEnabled>true</CentralPackageFloatingVersionsEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="$(EFCoreVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="$(EFCoreVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="$(EFCoreVersion)" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="$(EFCoreVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="$(EFCoreVersion)" />
  </ItemGroup>

  <!-- Security fixes for transitive packages that no responsible dependency carries yet
       (chapter "Versioning and compatibility", section on NuGet advisories). Each entry says
       where the vulnerable version comes from and when it can go. -->
  <ItemGroup>
    <!-- Shipped with the SQL Server package: EF Core SqlServer 10.0.x -> Microsoft.Data.SqlClient
         6.1.x -> Pkcs 9.0.4 to 9.0.11; 9.0.21 fixes GHSA-846f-f764-76mx and GHSA-2fmv-rv2c-59x7.
         Remove once the lowest supported EF Core SqlServer brings 9.0.21 or later. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="9.0.22" />
    <!-- Tooling only (tests, samples): EF Core Design 10.0.0 -> MSBuild 17.14 and Workspaces.MSBuild
         4.14 -> Xml/Pkcs 9.0.0; 9.0.22 fixes the Xml advisories and brings Pkcs 9.0.22. Remove
         once the lower bound of EFCoreVersion pulls fixed MSBuild packages. -->
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="9.0.22" />
  </ItemGroup>

  <!-- Tooling and test dependencies, independent of the EF version -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="3.3.4" />
    <!-- Released together with EF Core (10.0.x); follows the EF version so that newer EF
         patches do not cause a downgrade -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="$(EFCoreVersion)" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
    <!-- 4.14.0 and later depend on SSH.NET 2026.0.0 (GHSA-q939-rpr3-3284, GHSA-mggc-4xg6-vcxf) -->
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageVersion Include="Testcontainers.MsSql" Version="4.16.0" />
    <!-- Test only: checks that the plugin composes with a widely used convention plugin -->
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>
</Project>
