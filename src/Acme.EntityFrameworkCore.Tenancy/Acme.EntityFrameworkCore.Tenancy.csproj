<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Provider-independent core package: types that entity assemblies reference as well
    (TenantId, ITenantOwned, attributes), EF.Functions API, diagnostics, SaveChanges and
    materialization checks. Depends on EF Core only, not on Microsoft.EntityFrameworkCore.Relational:
    everything that needs ADO.NET or tables lives in Acme.EntityFrameworkCore.Tenancy.Relational.
  -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <Description>Multi-tenancy for EF Core: core abstractions for any EF Core provider.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
  </ItemGroup>
  <!-- Public API analyzer: reports every change to the public API
       (chapter "CI and API stability") -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <InternalsVisibleTo Include="Acme.EntityFrameworkCore.Tenancy.Tests" />
    <InternalsVisibleTo Include="Acme.EntityFrameworkCore.Tenancy.Benchmarks" />
  </ItemGroup>
</Project>
