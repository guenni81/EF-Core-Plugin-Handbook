<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Small sample plugin with PostgreSQL functions that have nothing to do with multi-tenancy:
    a custom SQL expression node (IS [NOT] DISTINCT FROM) and an aggregate (bool_and). Kept
    apart from the tenancy plugin so that it does not replace exclusive provider services
    (chapters "Custom SQL expression nodes" and "Aggregate translators").
  -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <Description>Sample EF Core plugin: IS DISTINCT FROM and bool_and for PostgreSQL.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
